<!doctype html>
<html>
<head>
    <title>HouseTask</title>
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/bootstrap/3.0.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="style.css">
</head>
<body>
<div class="container">

    <div class="page-header text-center">
        <h1><span class="fa-solid fa-hands-bubbles"></span> Profile Page</h1>
        <a href="/logout" class="btn btn-default btn-sm">Logout</a>
    </div>

    <div class="row">
        <div class="col-sm-6">
          <h3>Housetask</h3>
          <ul class="housetask">
          <% for(var i=0; i<housetask.length; i++) {%>
            <li class="housetask" data-task-id="<%=housetask[i]._id %>">
              <span>Created by: <%= housetask[i].created %></span>
              <span>Complete by: <%= housetask[i].date %></span>
              <span>Assigned: <%= housetask[i].assigned %></span>
              <label class="isCompleted">Completed <input class="complete-task" id="no-margin" type="checkbox" 
                <%= housetask[i].completed ? 'checked' : '' %>
                ></input></label>
              <span><i class="fa fa-trash" aria-hidden="true"></i></span>
            </li>
          <% } %>
          </ul>

          <h2>Add Task</h2>
        <% if (user.local.email) { %>
          <form action="/tasklist" method="POST">
            <input type="text" value="<%= user.local.username %>" name="username" disabled>
            <input type="text" placeholder="Task..." name="task">
            <input type="date" name="date" >
            <button type="submit">Submit</button>
          </form>
        </div>
        <% } %>

</div>

<script src="main.js"></script>

</body>
</html>
